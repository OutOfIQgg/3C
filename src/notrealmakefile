LDFLAGS = -L$(RAYLIB) -lraylib -lm -ldl -lpthread -lrt -lX11

AS = as
ASFLAGS = -g -c -I$(RAYLIB)/..

CC = gcc
CFLAGS = -Wall -g -I$(RAYLIB)/..

TARGET = test
SRC = main.s
OBJ = test.o

all: $(TARGET)

$(TARGET): $(OBJ)
	$(CC) $(OBJ) -o $(TARGET) $(CFLAGS) $(LDFLAGS)

$(OBJ): $(SRC)
	$(AS) $(ASFLAGS) $(SRC) -o $(OBJ)

clean:
	rm -f $(OBJ) $(TARGET)

.PHONY: all clean